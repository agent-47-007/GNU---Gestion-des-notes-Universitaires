user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#1B2942"><FONT COLOR="white"><B>Utilisateur</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U>Code_Utilisateur</U></TD></TR><TR><TD ALIGN="LEFT">Login</TD></TR><TR><TD ALIGN="LEFT">Mot_De_Passe_Hash</TD></TR><TR><TD ALIGN="LEFT">Role</TD></TR><TR><TD ALIGN="LEFT">Actif</TD></TR><TR><TD ALIGN="LEFT">Nom, Prénom</TD></TR></TABLE>>];
