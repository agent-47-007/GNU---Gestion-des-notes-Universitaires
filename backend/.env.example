APP_NAME="GNU Notes"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5435
DB_DATABASE=gnu_notes
DB_USERNAME=gnu_app
DB_PASSWORD=
DB_SSLMODE=prefer
# Base GNU existante à lire pour l’import du catalogue Informatique uniquement.
GNU_SOURCE_DB_HOST=127.0.0.1
GNU_SOURCE_DB_PORT=5435
GNU_SOURCE_DB_DATABASE=gnu_notes
GNU_SOURCE_DB_USERNAME=gnu_app
GNU_SOURCE_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=info
BCRYPT_ROUNDS=12
SANCTUM_EXPIRATION=480
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8780,http://localhost:8780
MAIL_MAILER=log
# Livraison SMTP réelle (remplacer par les paramètres fournis par l’établissement) :
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.example.org
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@example.org
# MAIL_FROM_NAME="GNU — Campus numérique"
GNU_ALLOW_DEMO_SEED=false
GNU_DEMO_PASSWORD=
GNU_PUBLICATION_ADMIN_LOGINS=
GNU_ENABLE_LOCAL_TEST_ACCOUNT_PORTAL=false
GNU_LOCAL_SETUP_DB_HOST=127.0.0.1
GNU_LOCAL_SETUP_DB_PORT=5435
GNU_LOCAL_SETUP_DB_DATABASE=gnu_notes
GNU_LOCAL_SETUP_DB_USERNAME=postgres
GNU_LOCAL_SETUP_DB_PASSWORD=
GNU_LOCAL_SETUP_DB_SSLMODE=disable
