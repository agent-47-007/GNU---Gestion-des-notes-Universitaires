{
  "info": {
    "name": "GNU Notes API",
    "description": "Collection Postman pour tester l'API GNU Notes Laravel.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "login", "value": "" },
    { "key": "password", "value": "" }
  ],
  "item": [
    {
      "name": "Authentification",
      "item": [
        {
          "name": "Connexion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Connexion réussie', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.token) { pm.collectionVariables.set('token', body.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{login}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman GNU\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Utilisateur courant",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Déconnexion",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        },
        {
          "name": "Déconnexion de tous les appareils",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/auth/logout-all", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout-all"] }
          }
        }
      ]
    },
    {
      "name": "Profils",
      "item": [
        {
          "name": "Profil étudiant",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profil/etudiant", "host": ["{{base_url}}"], "path": ["api", "v1", "profil", "etudiant"] }
          }
        },
        {
          "name": "Profil enseignant",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profil/enseignant", "host": ["{{base_url}}"], "path": ["api", "v1", "profil", "enseignant"] }
          }
        },
        {
          "name": "Profil agent",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/profil/agent", "host": ["{{base_url}}"], "path": ["api", "v1", "profil", "agent"] }
          }
        }
      ]
    },
    {
      "name": "Compte",
      "item": [
        {
          "name": "Changer le mot de passe",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"{{password}}\",\n  \"password\": \"NouveauMotDePasse2026!\",\n  \"password_confirmation\": \"NouveauMotDePasse2026!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/password", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "password"] }
          }
        },
        {
          "name": "Lister les comptes agent",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": { "raw": "{{base_url}}/api/v1/comptes", "host": ["{{base_url}}"], "path": ["api", "v1", "comptes"] }
          }
        }
      ]
    }
  ]
}
