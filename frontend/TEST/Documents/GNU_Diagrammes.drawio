=1;fontSize=24;fontColor=#1B2942;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="38" y="24" width="1080" height="40" /></mxCell><mxCell id="note0" value="Dépendance conditionnelle : « Joindre une preuve » étend « Soumettre une requête » si la requête concerne une absence." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="38" y="735" width="1100" height="20" /></mxCell><mxCell id="note1" value="La preuve est obligatoire dans cette branche. Les choix de l’enseignant sont limités à ses affectations." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="38" y="755" width="1100" height="20" /></mxCell><mxCell id="note2" value="L’enseignant décide : autoriser une évaluation, approuver une exception, attribuer 0 après absence ou rejeter." style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="38" y="775" width="1100" height="20" /></mxCell><mxCell id="boundary" value="GNU" style="rounded=0;html=1;verticalAlign=top;align=left;fillColor=none;strokeColor=#1B2942;" vertex="1" parent="1"><mxGeometry as="geometry" x="260" y="125" width="860" height="580" /></mxCell><mxCell id="ET" value="Étudiant" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="245" width="115" height="105" /></mxCell><mxCell id="EN" value="Enseignant" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=13;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="510" width="115" height="105" /></mxCell><mxCell id="consulter" value="Consulter notes et bulletins publiés" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F0F3F7;strokeColor=#1B2942;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="180" width="345" height="66" /></mxCell><mxCell id="choix" value="Choisir les UE du niveau&lt;br&gt;ou à reprendre" style="e