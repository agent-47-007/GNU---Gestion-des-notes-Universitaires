# Modèle sans secret ni domaine réel. Renseigner dans le gestionnaire de
# secrets de l'établissement, jamais dans Git.
APP_NAME="GNU Notes"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full

# Origine(s) exacte(s) de l'interface Web, séparées par des virgules.
CORS_ALLOWED_ORIGINS=

SESSION_DRIVER=file
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12
SANCTUM_EXPIRATION=480
GNU_PUBLICATION_ADMIN_LOGINS=
GNU_ENABLE_LOCAL_TEST_ACCOUNT_PORTAL=false
