digraph G {
graph [rankdir=LR, nodesep=0.55, ranksep=2.2, splines=polyline, overlap=false, bgcolor="#FAF8F2", pad=0.5];
node [shape=plain, fontname="Arial"];
edge [dir=none,fontname="Arial",fontsize=10,color="#77869B",labelfontsize=12,labeldistance=2.2];
